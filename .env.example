# Copy to .env (never commit .env). All values below are PUBLIC by design.
# They are inlined at build time, so set them in your build environment too
# (Cloudflare Workers Builds > Settings > Variables).

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
PUBLIC_SITE_URL=http://localhost:4321

# Supabase project URL and anon (publishable) key — Project Settings > API.
# Leave empty to run the public site entirely from the built-in tool registry.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google Search Console HTML-tag verification token (content value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# NEVER add the Supabase service_role key or any database password here.
# The application does not need them.
# ---------------------------------------------------------------------------

# Only for running the optional RLS integration tests locally (tests/integration).
# Use a dedicated test project. These are read by Vitest only, never bundled.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
SUPABASE_TEST_EDITOR_EMAIL=
SUPABASE_TEST_EDITOR_PASSWORD=
