---
import MainLayout from '../layouts/MainLayout.astro';
import ToolCard from '../components/common/ToolCard.astro';
import { isLocale, useT, localePath } from '../i18n';
import { listedTools } from '../lib/site/merge';
import { applyPageCsp } from '../lib/page';
import { getSiteData } from '../lib/supabase/public-data';
import type { Locale } from '../types/tool';

const seg = Astro.url.pathname.split('/')[1];
const locale: Locale = isLocale(seg) && seg !== 'en' ? seg : 'en';
const data = await getSiteData(locale);
await applyPageCsp(Astro, data.ads.enabled && !!data.ads.adsenseClient);
const ctx = { locale, data, t: useT(locale), path: '/' };
const t = ctx.t;
const popular = listedTools(data).filter((x) => x.popular).slice(0, 3);
Astro.response.status = 404;
---

<MainLayout ctx={ctx} meta={{ title: t('pages.notFound'), description: t('pages.notFoundText'), path: '/404/', locale, noindex: true }}>
  <div class="container-page py-20 text-center">
    <p class="text-6xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold">{t('pages.notFound')}</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">{t('pages.notFoundText')}</p>
    <a href={localePath(locale, '/')} class="btn-primary mt-6">{t('common.backHome')}</a>
    <ul class="mx-auto mt-12 grid max-w-4xl gap-4 text-start sm:grid-cols-3" role="list">
      {popular.map((tool) => <li><ToolCard ctx={ctx} tool={tool} headingLevel="h2" /></li>)}
    </ul>
  </div>
</MainLayout>
