---
import type { PageContext } from '../../lib/page';
interface Props {
  ctx: PageContext;
  size?: number;
}
const { ctx, size = 32 } = Astro.props;
const { branding } = ctx.data;
---

{
  branding.logoUrl ? (
    <img src={branding.logoUrl} alt="" width={size} height={size} class="rounded-lg" decoding="async" />
  ) : (
    <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="8" fill="var(--brand)" />
      <path d="M9 12.5 16 8l7 4.5v7L16 24l-7-4.5z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
      <path d="M9 12.5 16 17l7-4.5M16 17v7" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" opacity=".7" />
    </svg>
  )
}
<span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">{branding.siteName}</span>
