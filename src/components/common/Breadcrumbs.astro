---
import { Icon } from './Icon';
interface Props {
  items: { name: string; href: string }[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-slate-500 dark:text-slate-400">
    {
      items.map((it, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="ChevronRight" size={14} className="flip-rtl" />}
          {i === items.length - 1 ? (
            <span aria-current="page" class="font-medium text-slate-700 dark:text-slate-200">
              {it.name}
            </span>
          ) : (
            <a href={it.href} class="hover:text-brand-600">
              {it.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
