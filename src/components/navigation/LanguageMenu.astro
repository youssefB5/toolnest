---
import { Icon } from '../common/Icon';
import { LOCALES, LOCALE_NAMES, localePath } from '../../i18n';
import type { PageContext } from '../../lib/page';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { locale, path, t } = ctx;
---

<details class="relative" data-dropdown>
  <summary
    class="btn-ghost btn-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden"
    aria-label={`${t('nav.language')}: ${LOCALE_NAMES[locale]}`}
  >
    <Icon name="Globe" size={18} />
    <span class="hidden text-xs font-semibold uppercase sm:inline">{locale}</span>
  </summary>
  <ul class="card absolute end-0 top-full z-50 mt-2 w-40 p-1 shadow-[var(--shadow-pop)]" role="list">
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={localePath(l, path)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800',
              l === locale && 'font-semibold text-brand-600 dark:text-brand-200',
            ]}
          >
            {LOCALE_NAMES[l]}
            {l === locale && <Icon name="Check" size={14} />}
          </a>
        </li>
      ))
    }
  </ul>
</details>
