---
import { Icon } from '../common/Icon';
import SearchBox from '../navigation/SearchBox';
import LanguageMenu from '../navigation/LanguageMenu.astro';
import ThemeSwitcher from '../navigation/ThemeSwitcher.astro';
import Logo from '../common/Logo.astro';
import { localePath } from '../../i18n';
import type { PageContext } from '../../lib/page';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { data, locale, t } = ctx;
const cats = data.categories.filter((c) => c.visible);
const lp = (p: string) => localePath(locale, p);
const searchLabels = {
  placeholder: t('search.placeholder'),
  label: t('search.label'),
  noResults: t('search.noResults'),
  recent: t('search.recent'),
  suggested: t('search.suggested'),
  clear: t('search.clear'),
  hint: t('search.hint'),
};
const indexUrl = `/api/search-index.json?locale=${locale}`;
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75 dark:border-slate-800 dark:bg-slate-950/85"
>
  <div class="container-page flex h-16 items-center gap-3">
    <a href={lp('/')} class="flex shrink-0 items-center gap-2 rounded-md" aria-label={`${data.branding.siteName} — ${t('nav.home')}`}>
      <Logo ctx={ctx} />
    </a>

    <nav class="ms-4 hidden items-center gap-1 lg:flex" aria-label="Main">
      <a href={lp('/tools/')} class="btn-ghost btn-sm text-sm">{t('nav.allTools')}</a>
      <a href={lp('/popular/')} class="btn-ghost btn-sm text-sm">{t('nav.popular')}</a>
      <details class="relative" data-dropdown>
        <summary class="btn-ghost btn-sm cursor-pointer list-none text-sm [&::-webkit-details-marker]:hidden">
          {t('nav.categories')}
          <Icon name="ChevronDown" size={14} />
        </summary>
        <div class="card absolute start-0 top-full z-50 mt-2 grid w-[34rem] grid-cols-2 gap-1 p-2 shadow-[var(--shadow-pop)]">
          {
            cats.map((c) => (
              <a
                href={lp(`/categories/${c.slug}/`)}
                class="flex items-start gap-3 rounded-lg p-2.5 hover:bg-slate-50 dark:hover:bg-slate-800"
              >
                <span class="mt-0.5 rounded-md bg-brand-50 p-1.5 text-brand-600 dark:bg-brand-700/20 dark:text-brand-200">
                  <Icon name={c.icon} size={16} />
                </span>
                <span>
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white">{c.title}</span>
                  <span class="line-clamp-1 text-xs text-slate-500 dark:text-slate-400">{c.description}</span>
                </span>
              </a>
            ))
          }
        </div>
      </details>
      {data.navigation.map((n) => <a href={n.href} class="btn-ghost btn-sm text-sm">{n.label}</a>)}
    </nav>

    <div class="ms-auto hidden w-full max-w-sm md:block">
      <SearchBox client:idle indexUrl={indexUrl} labels={searchLabels} compact />
    </div>

    <div class="ms-auto flex items-center gap-1 md:ms-0">
      <a href={lp('/favorites/')} class="btn-ghost btn-sm hidden sm:inline-flex" aria-label={t('nav.favorites')} title={t('nav.favorites')}>
        <Icon name="Star" size={18} />
      </a>
      <LanguageMenu ctx={ctx} />
      <ThemeSwitcher ctx={ctx} />
      <details class="lg:hidden" data-dropdown data-mobile-menu>
        <summary class="btn-ghost btn-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden" aria-label={t('nav.menu')}>
          <Icon name="Menu" size={22} />
        </summary>
        <div class="fixed inset-x-0 top-16 z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-slate-200 bg-white p-4 shadow-[var(--shadow-pop)] dark:border-slate-800 dark:bg-slate-950">
          <div class="mb-4 md:hidden">
            <SearchBox client:idle indexUrl={indexUrl} labels={searchLabels} />
          </div>
          <nav class="grid gap-1" aria-label="Mobile">
            <a href={lp('/tools/')} class="rounded-lg px-3 py-2.5 font-medium hover:bg-slate-100 dark:hover:bg-slate-800">{t('nav.allTools')}</a>
            <a href={lp('/popular/')} class="rounded-lg px-3 py-2.5 font-medium hover:bg-slate-100 dark:hover:bg-slate-800">{t('nav.popular')}</a>
            <a href={lp('/recent/')} class="rounded-lg px-3 py-2.5 font-medium hover:bg-slate-100 dark:hover:bg-slate-800">{t('nav.recent')}</a>
            <a href={lp('/favorites/')} class="rounded-lg px-3 py-2.5 font-medium hover:bg-slate-100 dark:hover:bg-slate-800">{t('nav.favorites')}</a>
            <p class="mt-3 px-3 text-xs font-semibold tracking-wide text-slate-500 uppercase">{t('nav.categories')}</p>
            {
              cats.map((c) => (
                <a href={lp(`/categories/${c.slug}/`)} class="flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800">
                  <Icon name={c.icon} size={18} className="text-brand-600" />
                  {c.title}
                </a>
              ))
            }
            {data.navigation.map((n) => <a href={n.href} class="rounded-lg px-3 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800">{n.label}</a>)}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close <details> dropdowns on outside click and Escape; keeps menus keyboard friendly.
  const all = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown]'));
  document.addEventListener('click', (e) => {
    for (const d of all()) if (d.open && !d.contains(e.target as Node)) d.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const d of all()) {
      if (d.open) {
        d.open = false;
        d.querySelector('summary')?.focus();
      }
    }
  });
  for (const d of all()) {
    d.addEventListener('toggle', () => {
      if (d.open) for (const o of all()) if (o !== d && !o.contains(d)) o.open = false;
      if (d.hasAttribute('data-mobile-menu')) document.body.classList.toggle('overflow-hidden', d.open);
    });
  }
</script>
