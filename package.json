{
  "name": "toolnest",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "ToolNest — free, privacy-first online tools that run in your browser.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:sql": "node --experimental-strip-types scripts/generate-seed.ts",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,storage-api,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test-users": "node scripts/setup-local-supabase.mjs",
    "preview:local": "node scripts/preview-local.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.0.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.3.8",
    "dompurify": "^3.5.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "supabase": "^3.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
